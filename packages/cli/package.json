{
  "name": "@logicgraph/cli",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "logicgraph": "dist/src/index.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22.13 <23 || >=23.4"
  },
  "scripts": {
    "build": "pnpm --filter @logicgraph/core build && tsc -p tsconfig.json",
    "test": "pnpm --filter @logicgraph/core build && vitest run",
    "typecheck": "pnpm --filter @logicgraph/core build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@logicgraph/core": "workspace:*",
    "commander": "^14.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
